{
  // Type-checks every module; typings/ declares what the DOM library lacks.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    // strict's flags, one at a time: noImplicitAny is the one left.
    "alwaysStrict": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "skipLibCheck": true
  },
  "include": ["assets/**/*.js", "typings/*.d.ts"],
  "exclude": ["assets/vendor"]
}
