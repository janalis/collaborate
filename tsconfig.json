{
  // Type-checks every module (`strict` stays off for now); typings/ declares what the DOM library lacks.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "skipLibCheck": true
  },
  "include": ["assets/**/*.js", "typings/*.d.ts"],
  "exclude": ["assets/vendor"]
}
