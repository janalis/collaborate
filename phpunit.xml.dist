<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnRisky="true" failOnDeprecation="true"
         requireCoverageMetadata="true" beStrictAboutCoverageMetadata="true">
    <php>
        <!-- MariaDB (or MySQL 8) database the functional journal tests own; they create their tables. -->
        <env name="COLLABORATE_DATABASE_URL" value="mysql://root@127.0.0.1:3306/collaborate_test?serverVersion=10.11.0-MariaDB" force="false"/>
        <!-- The journal on PostgreSQL too (DraftJournalPlatformsTest), when set; SQLite needs no server. -->
        <env name="COLLABORATE_POSTGRES_URL" value="" force="false"/>
    </php>
    <testsuites>
        <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="functional"><directory>tests/Functional</directory></testsuite>
        <!-- The bundle inside the test applications of tests/Application, with and without EasyAdmin. -->
        <testsuite name="integration"><directory>tests/Integration</directory></testsuite>
        <testsuite name="tools"><directory>tests/Tools</directory></testsuite>
    </testsuites>
    <source ignoreIndirectDeprecations="true">
        <include><directory>src</directory><directory>tools</directory></include>
        <!-- The release tool's two-line entry script: it calls exit(), so only its subprocess test runs it. -->
        <!-- The deprecated names of the classes 0.5 moved: an alias declared at the top of the file, no class to cover. -->
        <exclude><file>tools/relprep.php</file><directory>src/EasyAdmin</directory></exclude>
    </source>
</phpunit>
