{% extends 'base.html.twig' %}
{% block body %}
    <h1>Articles</h1>
    <table class="table">
        <thead><tr><th>Id</th><th>Title</th><th>Status</th></tr></thead>
        <tbody>
        {% for article in articles %}
            <tr><td>{{ article.id }}</td><td><a href="{{ path('article_edit', {id: article.id}) }}">{{ article.title }}</a></td><td>{{ article.status }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    <a class="btn btn-primary" href="{{ path('article_new') }}">New article</a>
{% endblock %}
