{% extends 'base.html.twig' %}
{% block title %}{{ new ? 'New article' : article.title }}{% endblock %}
{% block body %}
    <h1>{{ new ? 'New article' : 'Edit ' ~ article.title }}</h1>
    {# The rows and the tag collection as the configured stock form theme renders them (PlainKernel::FORM_THEMES), in its
       own container: `form_table_layout`'s rows need its table. #}
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="button" class="btn btn-secondary btn-sm" data-add-tag="{{ form.tags.vars.id }}">Add tag</button>
        <button type="submit" class="btn btn-primary">Save</button>
    {{ form_end(form) }}
{% endblock %}
