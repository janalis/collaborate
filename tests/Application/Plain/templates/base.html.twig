<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Articles{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('build/plain.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/ckeditor5/ckeditor5.css') }}">
    {# Fluid controls whatever the form theme, as Bootstrap's: a page's layout follows its window; and room
       below the form, however compact the theme renders it, to scroll any field out of view. #}
    <style>
        main { padding-bottom: 100vh; }
        form table { width: 100%; }
        form input:not([type="checkbox"], [type="radio"]), form select, form textarea { box-sizing: border-box; width: 100%; }
    </style>
    {{ importmap('app') }}
</head>
<body>
<nav class="navbar navbar-expand bg-body-tertiary mb-3">
    <div class="container">
        <a class="navbar-brand" href="{{ path('article_index') }}">Articles</a>
        <div class="d-flex align-items-center gap-3">
            {{ collaborate_presence() }}
            {% if app.user %}<span class="navbar-text" data-signed-in>{{ app.user }}</span> <a href="{{ path('logout') }}">Sign out</a>{% endif %}
        </div>
    </div>
</nav>
<main class="container">
    {% for message in app.flashes('warning') %}<div class="alert alert-warning" role="alert">{{ message }}</div>{% endfor %}
    {% block body %}{% endblock %}
</main>
{{ collaborate_layer() }}
</body>
</html>
