{
  // Type-checks every module; typings/ declares what the DOM library lacks.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "skipLibCheck": true,
    // The Drupal module's scripts import the bundle's by the name its import map gives them.
    "paths": { "@janalis/collaborate/*": ["./assets/*"] }
  },
  "include": ["assets/**/*.js", "drupal/js/*.js", "typings/*.d.ts"],
  "exclude": ["assets/vendor"]
}
